//@version=6
// ── VOLATILITY RED BOX add-on (derived empirically, see backtest/REPORT_VOLBOX.md)
// Paste these lines into your existing script and AND them into validBuy/validSell.

useVolBox = input.bool(true,  "Enable Volatility Red Box", group="Vol Red Box")
atrMinUsd = input.float(1.3,  "Min ATR14 (USD)", minval=0.1, step=0.1, group="Vol Red Box")
sepAtrMin = input.float(0.06, "Min EMA gap / ATR",  minval=0.0, step=0.01, group="Vol Red Box")

atr14  = ta.atr(14)
sepAtr = math.abs(emaFast - emaSlow) / atr14
volBoxBlock = useVolBox and (atr14 < atrMinUsd or sepAtr < sepAtrMin)

// then:  validBuy  = bullCross and htfBullish and not boxBlock and not volBoxBlock and inBacktest
//        validSell = bearCross and htfBearish and not boxBlock and not volBoxBlock and inBacktest

// optional visual: shade the bars the vol-box blocks
bgcolor(volBoxBlock ? color.new(color.red, 88) : na, title="Vol Red Box")
